// IPT PowerTech Telecom Power PM System — database schema (MySQL 8+).
//
// Conventions
// - Primary keys: UUID v7 (time-ordered) stored as CHAR(36). Records created
//   offline on the phone carry client-generated UUIDs.
// - Every table: created_at / updated_at; created_by / updated_by where a
//   person makes the change. Timestamps are UTC (DATETIME(3)).
// - Records are deactivated, not deleted, when history refers to them.
// - is_demo marks demonstration data (the Tienii 1301 report) so it can be
//   told apart from, and removed without touching, operational data.
// - Hierarchy consistency (county → cluster → region) and value ranges are
//   also enforced in MySQL (triggers / CHECK constraints in the migrations).

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// People, roles and permissions
// -----------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  /// Stored lower-case; unique.
  email              String    @unique @db.VarChar(254)
  fullName           String    @map("full_name") @db.VarChar(120)
  phone              String?   @db.VarChar(32)
  employeeCode       String?   @unique @map("employee_code") @db.VarChar(32)
  /// Argon2id hash; null until the user has set a password.
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  isActive           Boolean   @default(true) @map("is_active")
  /// Home region (technicians, supervisors). Access scope is user_region_scopes.
  homeRegionId       String?   @map("home_region_id") @db.Char(36)
  /// Line manager, e.g. a technician's supervisor.
  reportsToId        String?   @map("reports_to_id") @db.Char(36)
  lastLoginAt        DateTime? @map("last_login_at")
  /// Set when an administrator gives a temporary password: every route except
  /// changing it is refused until the user sets their own.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// Consecutive failed sign-ins; the account locks for a while at the limit.
  failedLoginCount   Int       @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil        DateTime? @map("locked_until")
  /// Access tokens issued before this moment are refused (sign-out everywhere,
  /// password change, deactivation).
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  isDemo             Boolean   @default(false) @map("is_demo")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdById        String?   @map("created_by") @db.Char(36)
  updatedById        String?   @map("updated_by") @db.Char(36)

  homeRegion    Region? @relation("UserHomeRegion", fields: [homeRegionId], references: [id], onDelete: Restrict)
  reportsTo     User?   @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: Restrict)
  directReports User[]  @relation("UserReportsTo")
  createdBy     User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User?   @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  roles            UserRole[]        @relation("UserRoleUser")
  regionScopes     UserRegionScope[] @relation("UserRegionScopeUser")
  siteAssignments  SiteAssignment[]  @relation("SiteAssignmentUser")
  refreshTokens    RefreshToken[]
  pmSchedules      PmSchedule[]      @relation("PmScheduleTechnician")
  pmVisits         PmVisit[]         @relation("PmVisitTechnician")
  pmVisitsReviewed PmVisit[]         @relation("PmVisitReviewer")
  pmPhotos         PmPhoto[]

  // Audit back-relations (who created / changed what).
  usersCreated     User[]            @relation("UserCreatedBy")
  usersUpdated     User[]            @relation("UserUpdatedBy")
  rolesGranted     UserRole[]        @relation("UserRoleGrantedBy")
  scopesGranted    UserRegionScope[] @relation("UserRegionScopeGrantedBy")
  regionsCreated   Region[]          @relation("RegionCreatedBy")
  regionsUpdated   Region[]          @relation("RegionUpdatedBy")
  clustersCreated  Cluster[]         @relation("ClusterCreatedBy")
  clustersUpdated  Cluster[]         @relation("ClusterUpdatedBy")
  countiesCreated  County[]          @relation("CountyCreatedBy")
  countiesUpdated  County[]          @relation("CountyUpdatedBy")
  sitesCreated     Site[]            @relation("SiteCreatedBy")
  sitesUpdated     Site[]            @relation("SiteUpdatedBy")
  assignmentsMade  SiteAssignment[]  @relation("SiteAssignmentAssignedBy")
  assignmentsEnded SiteAssignment[]  @relation("SiteAssignmentEndedBy")

  @@index([homeRegionId])
  @@index([reportsToId])
  @@index([isActive])
  @@index([fullName])
  @@map("users")
}

/// One row per issued refresh token. Tokens rotate on every use: the used
/// token is revoked and replaced within the same family. Presenting a revoked
/// token again (reuse, e.g. a stolen copy) revokes the whole family.
/// Only the token id is stored; the token itself is a signed JWT.
model RefreshToken {
  id            String    @id @db.Char(36)
  userId        String    @map("user_id") @db.Char(36)
  familyId      String    @map("family_id") @db.Char(36)
  /// web | mobile — shown in the user's sessions and used in the audit log.
  client        String    @db.VarChar(16)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  /// ROTATED | LOGOUT | LOGOUT_ALL | REUSE_DETECTED | PASSWORD_CHANGED | USER_DEACTIVATED | PASSWORD_RESET
  revokedReason String?   @map("revoked_reason") @db.VarChar(32)
  replacedById  String?   @map("replaced_by_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Roles: SUPER_ADMIN, REGIONAL_MANAGER, REGIONAL_SUPERVISOR, TECHNICIAN,
/// MAINTENANCE_USER, VIEWER (system roles, seeded). What a role may do is its
/// permissions; where it may do it is the user's organisational scope.
model Role {
  id          String   @id @default(uuid(7)) @db.Char(36)
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(255)
  /// System roles are maintained by the seed and cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Explicit permissions checked by the API (e.g. `sites.manage`).
model Permission {
  id          String   @id @default(uuid(7)) @db.Char(36)
  code        String   @unique @db.VarChar(64)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Char(36)
  roleId      String   @map("role_id") @db.Char(36)
  grantedById String?  @map("granted_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Regions a manager or supervisor may work in (their organisational scope).
model UserRegionScope {
  userId      String   @map("user_id") @db.Char(36)
  regionId    String   @map("region_id") @db.Char(36)
  grantedById String?  @map("granted_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  user      User   @relation("UserRegionScopeUser", fields: [userId], references: [id], onDelete: Cascade)
  region    Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  grantedBy User?  @relation("UserRegionScopeGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, regionId])
  @@index([regionId])
  @@map("user_region_scopes")
}

// -----------------------------------------------------------------------------
// Organisation: Region → Cluster → County → Site
// -----------------------------------------------------------------------------

model Region {
  id          String   @id @default(uuid(7)) @db.Char(36)
  code        String   @unique @db.VarChar(32)
  name        String   @unique @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  createdBy User? @relation("RegionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("RegionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  clusters    Cluster[]
  sites       Site[]
  homeOfUsers User[]            @relation("UserHomeRegion")
  scopes      UserRegionScope[]

  @@map("regions")
}

model Cluster {
  id          String   @id @default(uuid(7)) @db.Char(36)
  regionId    String   @map("region_id") @db.Char(36)
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  region    Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("ClusterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?  @relation("ClusterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  counties County[]
  sites    Site[]

  @@unique([regionId, name])
  @@map("clusters")
}

model County {
  id          String   @id @default(uuid(7)) @db.Char(36)
  clusterId   String   @map("cluster_id") @db.Char(36)
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("CountyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("CountyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  sites Site[]

  @@unique([clusterId, name])
  @@map("counties")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

/// A telecom site. Cluster and county are optional (not always known); when
/// set they must belong to the site's region (enforced by the API and by a
/// database trigger).
model Site {
  id                   String     @id @default(uuid(7)) @db.Char(36)
  siteCode             String     @unique @map("site_code") @db.VarChar(32)
  siteName             String     @map("site_name") @db.VarChar(120)
  regionId             String     @map("region_id") @db.Char(36)
  clusterId            String?    @map("cluster_id") @db.Char(36)
  countyId             String?    @map("county_id") @db.Char(36)
  latitude             Decimal?   @db.Decimal(9, 6)
  longitude            Decimal?   @db.Decimal(9, 6)
  address              String?    @db.VarChar(500)
  siteType             String?    @map("site_type") @db.VarChar(50)
  status               SiteStatus @default(ACTIVE)
  generatorAvailable   Boolean    @default(false) @map("generator_available")
  solarAvailable       Boolean    @default(false) @map("solar_available")
  gridAvailable        Boolean    @default(false) @map("grid_available")
  batteryConfiguration String?    @map("battery_configuration") @db.VarChar(500)
  powerConfiguration   String?    @map("power_configuration") @db.VarChar(500)
  /// Number of batteries in the bank. When set, a PM records each battery's voltage.
  batteryUnitCount     Int?       @map("battery_unit_count") @db.UnsignedSmallInt
  /// PM start geofence radius for this site (metres); the system setting applies when empty.
  geofenceRadiusM      Int?       @map("geofence_radius_m") @db.UnsignedInt
  isDemo               Boolean    @default(false) @map("is_demo")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  createdById          String?    @map("created_by") @db.Char(36)
  updatedById          String?    @map("updated_by") @db.Char(36)

  region    Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  cluster   Cluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  county    County?  @relation(fields: [countyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("SiteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?    @relation("SiteUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  assignments SiteAssignment[]
  pmSchedules PmSchedule[]
  pmVisits    PmVisit[]

  generatorReadings GeneratorReading[]
  dcReadings        DcReading[]
  dcPhaseCurrents   DcPhaseCurrent[]
  batteryReadings   BatteryReading[]
  batteryUnits      BatteryUnitReading[]
  solarReadings     SolarReading[]
  nonTechnical      NonTechnicalObservation[]
  earthingReadings  EarthingReading[]

  @@index([siteName])
  @@index([regionId])
  @@index([clusterId])
  @@index([countyId])
  @@index([status])
  @@index([createdAt])
  @@map("sites")
}

enum AssignmentRole {
  TECHNICIAN
  SUPERVISOR
}

/// Who works on a site, over time. Assignments are ended (end_date, active =
/// false), never deleted, so the history is kept. A site has at most one
/// active supervisor; it may have several active technicians.
model SiteAssignment {
  id           String         @id @default(uuid(7)) @db.Char(36)
  siteId       String         @map("site_id") @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  role         AssignmentRole
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  active       Boolean        @default(true)
  endReason    String?        @map("end_reason") @db.VarChar(255)
  isDemo       Boolean        @default(false) @map("is_demo")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  assignedById String?        @map("assigned_by") @db.Char(36)
  endedById    String?        @map("ended_by") @db.Char(36)

  site       Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  user       User  @relation("SiteAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("SiteAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy    User? @relation("SiteAssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([siteId, role, active])
  @@index([userId, active])
  @@index([startDate])
  @@map("site_assignments")
}

// -----------------------------------------------------------------------------
// PM engine: templates (versioned) → sections → checklist items / reading
// fields; schedules; visits with responses, readings and photos.
//
// - A template version is edited only while DRAFT. Activating it retires the
//   previous ACTIVE version of the same code (one ACTIVE per code, also
//   enforced by a trigger) and moves open schedules to it; visits keep the
//   version they started on.
// - Nothing here holds engineering limits: min/max values exist only where an
//   administrator sets them (the reference template sets definitional bounds
//   only, e.g. percent 0–100, counts >= 0).
// - created_by / updated_by on these tables record who made a change; the full
//   history is in the audit log (Phase 13).
// -----------------------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PmCategory {
  GENERATOR
  DC_SYSTEM
  BATTERY
  SOLAR
  NON_TECHNICAL
  EARTHING
  OTHER
}

/// Site equipment flag that makes a section not applicable when the site lacks it.
enum SiteEquipment {
  GENERATOR
  SOLAR
  GRID
}

enum ResponseType {
  YES_NO_NA
  NUMBER
  TEXT
  SELECT
  MULTI_SELECT
  DATE
  DATETIME
  PHOTO
}

enum ReadingValueType {
  NUMBER
  TEXT
  SELECT
}

enum Answer {
  YES
  NO
  NA
}

enum YesNo {
  YES
  NO
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PmFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  AD_HOC
}

/// SCHEDULED → IN_PROGRESS → COMPLETED (technician finished, awaiting review)
/// → APPROVED | REJECTED (returned to the technician); OVERDUE when still
/// open after the due date; CANCELLED.
enum GeofenceMode {
  WARN
  REQUIRE_REASON
  BLOCK
}

enum GpsStatus {
  WITHIN_RADIUS
  OUTSIDE_RADIUS
  UNAVAILABLE
  SITE_HAS_NO_COORDINATES
}

enum PmStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
  OVERDUE
  CANCELLED
}

model PmTemplate {
  id          String         @id @default(uuid(7)) @db.Char(36)
  code        String         @db.VarChar(40)
  name        String         @db.VarChar(120)
  version     Int            @db.UnsignedSmallInt
  status      TemplateStatus @default(DRAFT)
  description String?        @db.VarChar(1000)
  activatedAt DateTime?      @map("activated_at")
  retiredAt   DateTime?      @map("retired_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  createdById String?        @map("created_by") @db.Char(36)
  updatedById String?        @map("updated_by") @db.Char(36)

  sections  PmSection[]
  schedules PmSchedule[]
  visits    PmVisit[]

  @@unique([code, version])
  @@index([status])
  @@map("pm_templates")
}

model PmSection {
  id                 String         @id @default(uuid(7)) @db.Char(36)
  templateId         String         @map("template_id") @db.Char(36)
  code               String         @db.VarChar(40)
  name               String         @db.VarChar(120)
  category           PmCategory
  sortOrder          Int            @default(0) @map("sort_order") @db.SmallInt
  description        String?        @db.VarChar(1000)
  allowNotApplicable Boolean        @default(false) @map("allow_not_applicable")
  /// The section is not applicable (by default) at sites without this equipment.
  requiresEquipment  SiteEquipment? @map("requires_equipment")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  createdById        String?        @map("created_by") @db.Char(36)
  updatedById        String?        @map("updated_by") @db.Char(36)

  template      PmTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  items         PmChecklistItem[]
  readingFields PmReadingField[]

  @@unique([templateId, code])
  @@index([templateId, sortOrder])
  @@map("pm_sections")
}

/// A question of the checklist. `failureOnAnswer` is the failure rule: the
/// answer (YES or NO) that records a failure of `failureSeverity`.
model PmChecklistItem {
  id                       String       @id @default(uuid(7)) @db.Char(36)
  sectionId                String       @map("section_id") @db.Char(36)
  code                     String       @db.VarChar(60)
  prompt                   String       @db.VarChar(500)
  helpText                 String?      @map("help_text") @db.VarChar(1000)
  responseType             ResponseType @default(YES_NO_NA) @map("response_type")
  /// Choices for SELECT / MULTI_SELECT (JSON array of strings).
  options                  Json?
  allowNotApplicable       Boolean      @default(true) @map("allow_not_applicable")
  isRequired               Boolean      @default(true) @map("is_required")
  unit                     String?      @db.VarChar(20)
  minValue                 Decimal?     @map("min_value") @db.Decimal(18, 6)
  maxValue                 Decimal?     @map("max_value") @db.Decimal(18, 6)
  isInteger                Boolean      @default(false) @map("is_integer")
  failureOnAnswer          YesNo?       @map("failure_on_answer")
  failureSeverity          Severity     @default(MEDIUM) @map("failure_severity")
  requiresPhotoOnFailure   Boolean      @default(false) @map("requires_photo_on_failure")
  requiresCommentOnFailure Boolean      @default(false) @map("requires_comment_on_failure")
  /// Answers that need a photo / a comment whether or not they are failures (JSON array of YES|NO|NA).
  photoOnAnswers           Json?        @map("photo_on_answers")
  commentOnAnswers         Json?        @map("comment_on_answers")
  photoInstructions        String?      @map("photo_instructions") @db.VarChar(500)
  analyticsKey             String?      @map("analytics_key") @db.VarChar(80)
  sortOrder                Int          @default(0) @map("sort_order") @db.SmallInt
  isActive                 Boolean      @default(true) @map("is_active")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  createdById              String?      @map("created_by") @db.Char(36)
  updatedById              String?      @map("updated_by") @db.Char(36)

  section   PmSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses PmResponse[]
  photos    PmPhoto[]

  @@unique([sectionId, code])
  @@index([sectionId, sortOrder])
  @@index([analyticsKey])
  @@map("pm_checklist_items")
}

/// A measured value recorded on each visit (e.g. Running Hours, Battery Voltage).
model PmReadingField {
  id           String           @id @default(uuid(7)) @db.Char(36)
  sectionId    String           @map("section_id") @db.Char(36)
  code         String           @db.VarChar(60)
  label        String           @db.VarChar(200)
  valueType    ReadingValueType @default(NUMBER) @map("value_type")
  unit         String?          @db.VarChar(20)
  isInteger    Boolean          @default(false) @map("is_integer")
  minValue     Decimal?         @map("min_value") @db.Decimal(18, 6)
  maxValue     Decimal?         @map("max_value") @db.Decimal(18, 6)
  options      Json?
  isRequired   Boolean          @default(false) @map("is_required")
  helpText     String?          @map("help_text") @db.VarChar(1000)
  analyticsKey String?          @map("analytics_key") @db.VarChar(80)
  sortOrder    Int              @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdById  String?          @map("created_by") @db.Char(36)
  updatedById  String?          @map("updated_by") @db.Char(36)

  section  PmSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  readings PmReading[]

  @@unique([sectionId, code])
  @@index([sectionId, sortOrder])
  @@index([analyticsKey])
  @@map("pm_reading_fields")
}

/// Relationships between keyed values checked before completion
/// (e.g. dc.dc_modules_operational <= dc.dc_modules_installed).
model PmConsistencyRule {
  id          String   @id @default(uuid(7)) @db.Char(36)
  lhsKey      String   @map("lhs_key") @db.VarChar(80)
  operator    String   @db.VarChar(2)
  rhsKey      String   @map("rhs_key") @db.VarChar(80)
  message     String   @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by") @db.Char(36)
  updatedById String?  @map("updated_by") @db.Char(36)

  @@unique([lhsKey, operator, rhsKey])
  @@map("pm_consistency_rules")
}

/// A planned PM of a site by a technician. Recurring plans are created as one
/// row per occurrence sharing a series id.
model PmSchedule {
  id            String      @id @default(uuid(7)) @db.Char(36)
  siteId        String      @map("site_id") @db.Char(36)
  templateId    String      @map("template_id") @db.Char(36)
  technicianId  String?     @map("technician_id") @db.Char(36)
  seriesId      String?     @map("series_id") @db.Char(36)
  frequency     PmFrequency @default(MONTHLY)
  scheduledDate DateTime    @map("scheduled_date") @db.Date
  dueDate       DateTime    @map("due_date") @db.Date
  status        PmStatus    @default(SCHEDULED)
  priority      Priority    @default(MEDIUM)
  notes         String?     @db.VarChar(1000)
  cancelReason  String?     @map("cancel_reason") @db.VarChar(255)
  isDemo        Boolean     @default(false) @map("is_demo")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  createdById   String?     @map("created_by") @db.Char(36)
  updatedById   String?     @map("updated_by") @db.Char(36)

  site       Site       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  template   PmTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  technician User?      @relation("PmScheduleTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  visits     PmVisit[]

  @@index([siteId, scheduledDate])
  @@index([technicianId, dueDate])
  @@index([status, dueDate])
  @@index([seriesId])
  @@map("pm_schedules")
}

/// A PM carried out at a site, on the template version it started with.
model PmVisit {
  id                    String        @id @db.Char(36)
  scheduleId            String?       @map("schedule_id") @db.Char(36)
  siteId                String        @map("site_id") @db.Char(36)
  templateId            String        @map("template_id") @db.Char(36)
  technicianId          String        @map("technician_id") @db.Char(36)
  status                PmStatus      @default(IN_PROGRESS)
  startedAt             DateTime      @map("started_at")
  completedAt           DateTime?     @map("completed_at")
  completionPct         Decimal       @default(0) @map("completion_pct") @db.Decimal(5, 2)
  failureCount          Int           @default(0) @map("failure_count") @db.UnsignedSmallInt
  /// Section codes marked not applicable (JSON array).
  notApplicableSections Json          @map("not_applicable_sections")
  overallComments       String?       @map("overall_comments") @db.VarChar(4000)
  reviewedById          String?       @map("reviewed_by") @db.Char(36)
  reviewedAt            DateTime?     @map("reviewed_at")
  reviewComments        String?       @map("review_comments") @db.VarChar(2000)
  clientCreatedAt       DateTime?     @map("client_created_at")
  /// Where the technician was when starting (as reported by the phone), and the geofence result.
  gpsLatitude           Decimal?      @map("gps_latitude") @db.Decimal(9, 6)
  gpsLongitude          Decimal?      @map("gps_longitude") @db.Decimal(9, 6)
  gpsAccuracyM          Decimal?      @map("gps_accuracy_m") @db.Decimal(10, 2)
  gpsCapturedAt         DateTime?     @map("gps_captured_at")
  gpsDistanceM          Decimal?      @map("gps_distance_m") @db.Decimal(12, 2)
  gpsRadiusM            Int?          @map("gps_radius_m") @db.UnsignedInt
  gpsStatus             GpsStatus?    @map("gps_status")
  geofenceMode          GeofenceMode? @map("geofence_mode")
  outsideRadiusReason   String?       @map("outside_radius_reason") @db.VarChar(500)
  /// The technician's signature (storage key of a server-drawn SVG).
  signatureKey          String?       @map("signature_key") @db.VarChar(255)
  signedAt              DateTime?     @map("signed_at")
  signedName            String?       @map("signed_name") @db.VarChar(120)
  isDemo                Boolean       @default(false) @map("is_demo")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  createdById           String?       @map("created_by") @db.Char(36)
  updatedById           String?       @map("updated_by") @db.Char(36)

  schedule   PmSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  template   PmTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  technician User         @relation("PmVisitTechnician", fields: [technicianId], references: [id], onDelete: Restrict)
  reviewedBy User?        @relation("PmVisitReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  responses  PmResponse[]
  readings   PmReading[]
  photos     PmPhoto[]

  generator    GeneratorReading?
  dc           DcReading?
  dcPhases     DcPhaseCurrent[]
  battery      BatteryReading?
  batteryUnits BatteryUnitReading[]
  solar        SolarReading?
  nonTechnical NonTechnicalObservation?
  earthing     EarthingReading?

  @@index([siteId, startedAt])
  @@index([technicianId, startedAt])
  @@index([status])
  @@index([scheduleId])
  @@map("pm_visits")
}

/// An answer to a checklist item. Prompt and unit are copied at answer time.
model PmResponse {
  id              String    @id @default(uuid(7)) @db.Char(36)
  visitId         String    @map("visit_id") @db.Char(36)
  checklistItemId String    @map("checklist_item_id") @db.Char(36)
  answer          Answer?
  numericValue    Decimal?  @map("numeric_value") @db.Decimal(18, 6)
  textValue       String?   @map("text_value") @db.VarChar(2000)
  selectedOptions Json?     @map("selected_options")
  dateValue       DateTime? @map("date_value") @db.Date
  datetimeValue   DateTime? @map("datetime_value")
  comment         String?   @db.VarChar(2000)
  isFailure       Boolean   @default(false) @map("is_failure")
  promptSnapshot  String    @map("prompt_snapshot") @db.VarChar(500)
  unitSnapshot    String?   @map("unit_snapshot") @db.VarChar(20)
  answeredAt      DateTime  @map("answered_at")
  answeredById    String?   @map("answered_by") @db.Char(36)
  clientUpdatedAt DateTime? @map("client_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  visit PmVisit         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  item  PmChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@unique([visitId, checklistItemId])
  @@index([checklistItemId])
  @@index([visitId, isFailure])
  @@map("pm_responses")
}

model PmReading {
  id              String    @id @default(uuid(7)) @db.Char(36)
  visitId         String    @map("visit_id") @db.Char(36)
  readingFieldId  String    @map("reading_field_id") @db.Char(36)
  numericValue    Decimal?  @map("numeric_value") @db.Decimal(18, 6)
  textValue       String?   @map("text_value") @db.VarChar(500)
  labelSnapshot   String    @map("label_snapshot") @db.VarChar(200)
  unitSnapshot    String?   @map("unit_snapshot") @db.VarChar(20)
  capturedAt      DateTime  @map("captured_at")
  clientUpdatedAt DateTime? @map("client_updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  visit PmVisit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  field PmReadingField @relation(fields: [readingFieldId], references: [id], onDelete: Restrict)

  @@unique([visitId, readingFieldId])
  @@index([readingFieldId])
  @@map("pm_readings")
}

/// A photo taken during a visit (optionally for one checklist item). The file
/// is in storage under `storage_key`; the database never holds file contents.
model PmPhoto {
  id              String    @id @db.Char(36)
  visitId         String    @map("visit_id") @db.Char(36)
  checklistItemId String?   @map("checklist_item_id") @db.Char(36)
  storageKey      String    @unique @map("storage_key") @db.VarChar(255)
  contentType     String    @map("content_type") @db.VarChar(40)
  sizeBytes       Int       @map("size_bytes") @db.UnsignedInt
  sha256          String    @db.Char(64)
  caption         String?   @db.VarChar(255)
  takenAt         DateTime? @map("taken_at")
  uploadedById    String    @map("uploaded_by") @db.Char(36)
  createdAt       DateTime  @default(now()) @map("created_at")

  visit      PmVisit          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  item       PmChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([visitId, checklistItemId])
  @@map("pm_photos")
}

// -----------------------------------------------------------------------------
// Power modules: one record per visit and section, kept in step with the
// visit's answers and readings (through the template's analytics keys), for
// history and analytics. Measured values are copied unchanged; calculated
// values (DC kW, total phase current) have their own columns. A section
// marked not applicable has no record.
// -----------------------------------------------------------------------------

model GeneratorReading {
  visitId           String   @id @map("visit_id") @db.Char(36)
  siteId            String   @map("site_id") @db.Char(36)
  recordedAt        DateTime @map("recorded_at")
  runningHours      Decimal? @map("running_hours") @db.Decimal(18, 6)
  /// As recorded (the gauge value or its status, e.g. "Okay").
  oilPressure       String?  @map("oil_pressure") @db.VarChar(500)
  oilPressureBar    Decimal? @map("oil_pressure_bar") @db.Decimal(18, 6)
  fuelLevelPct      Decimal? @map("fuel_level_pct") @db.Decimal(18, 6)
  generatorKva      Decimal? @map("generator_kva") @db.Decimal(18, 6)
  engineOilChanged  Boolean? @map("engine_oil_changed")
  fuelFilterChanged Boolean? @map("fuel_filter_changed")
  oilFilterChanged  Boolean? @map("oil_filter_changed")
  requiresService   Boolean? @map("requires_service")
  updatedAt         DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("generator_readings")
}

model DcReading {
  visitId              String   @id @map("visit_id") @db.Char(36)
  siteId               String   @map("site_id") @db.Char(36)
  recordedAt           DateTime @map("recorded_at")
  rectifierVoltageV    Decimal? @map("rectifier_voltage_v") @db.Decimal(18, 6)
  loadCurrentA         Decimal? @map("load_current_a") @db.Decimal(18, 6)
  rectifierModuleCount Int?     @map("rectifier_module_count")
  dcModulesInstalled   Int?     @map("dc_modules_installed")
  dcModulesOperational Int?     @map("dc_modules_operational")
  controllerModel      String?  @map("controller_model") @db.VarChar(500)
  /// Calculated: rectifier voltage × load current / 1000 (exact decimal arithmetic).
  dcPowerKw            Decimal? @map("dc_power_kw") @db.Decimal(18, 6)
  /// Calculated: sum of the recorded clamp-meter phase currents.
  totalPhaseCurrentA   Decimal? @map("total_phase_current_a") @db.Decimal(18, 6)
  phasesRecorded       Int      @default(0) @map("phases_recorded") @db.UnsignedTinyInt
  updatedAt            DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("dc_readings")
}

/// Clamp-meter amp load per phase (phases 1–7 in the reference template).
model DcPhaseCurrent {
  visitId     String   @map("visit_id") @db.Char(36)
  phaseNumber Int      @map("phase_number") @db.UnsignedTinyInt
  siteId      String   @map("site_id") @db.Char(36)
  recordedAt  DateTime @map("recorded_at")
  ampValue    Decimal  @map("amp_value") @db.Decimal(18, 6)
  comment     String?  @db.VarChar(2000)
  updatedAt   DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@id([visitId, phaseNumber])
  @@index([siteId, recordedAt])
  @@map("dc_phase_currents")
}

model BatteryReading {
  visitId             String   @id @map("visit_id") @db.Char(36)
  siteId              String   @map("site_id") @db.Char(36)
  recordedAt          DateTime @map("recorded_at")
  batteryVoltageV     Decimal? @map("battery_voltage_v") @db.Decimal(18, 6)
  capacityAh          Decimal? @map("capacity_ah") @db.Decimal(18, 6)
  stringCount         Int?     @map("string_count")
  physicalDamageFound Boolean? @map("physical_damage_found")
  waterTopUpRequired  Boolean? @map("water_top_up_required")
  /// Calculated from the per-battery readings, when recorded.
  unitsRecorded       Int      @default(0) @map("units_recorded") @db.UnsignedSmallInt
  minUnitVoltageV     Decimal? @map("min_unit_voltage_v") @db.Decimal(18, 6)
  maxUnitVoltageV     Decimal? @map("max_unit_voltage_v") @db.Decimal(18, 6)
  updatedAt           DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("battery_readings")
}

/// The voltage of each battery in the bank, at sites where the battery count is configured.
model BatteryUnitReading {
  visitId         String    @map("visit_id") @db.Char(36)
  unitNumber      Int       @map("unit_number") @db.UnsignedSmallInt
  siteId          String    @map("site_id") @db.Char(36)
  voltageV        Decimal   @map("voltage_v") @db.Decimal(18, 6)
  comment         String?   @db.VarChar(500)
  recordedAt      DateTime  @map("recorded_at")
  clientUpdatedAt DateTime? @map("client_updated_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@id([visitId, unitNumber])
  @@index([siteId, recordedAt])
  @@map("battery_unit_readings")
}

model SolarReading {
  visitId                 String   @id @map("visit_id") @db.Char(36)
  siteId                  String   @map("site_id") @db.Char(36)
  recordedAt              DateTime @map("recorded_at")
  panelsInstalled         Int?     @map("panels_installed")
  panelsOperational       Int?     @map("panels_operational")
  damagedPanelCount       Int?     @map("damaged_panel_count")
  chargeControllerOutputV Decimal? @map("charge_controller_output_v") @db.Decimal(18, 6)
  panelsCleaned           Boolean? @map("panels_cleaned")
  systemOperatingNormally Boolean? @map("system_operating_normally")
  updatedAt               DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("solar_readings")
}

model NonTechnicalObservation {
  visitId                 String   @id @map("visit_id") @db.Char(36)
  siteId                  String   @map("site_id") @db.Char(36)
  recordedAt              DateTime @map("recorded_at")
  powerEquipmentCleaned   Boolean? @map("power_equipment_cleaned")
  dustRemoved             Boolean? @map("dust_removed")
  shelterCleaned          Boolean? @map("shelter_cleaned")
  vegetationClear         Boolean? @map("vegetation_clear")
  freeOfDebris            Boolean? @map("free_of_debris")
  cableTraysOrganised     Boolean? @map("cable_trays_organised")
  fenceGateGood           Boolean? @map("fence_gate_good")
  equipmentMissing        Boolean? @map("equipment_missing")
  securityLightsWorking   Boolean? @map("security_lights_working")
  aviationLightsWorking   Boolean? @map("aviation_lights_working")
  locksSecure             Boolean? @map("locks_secure")
  oilFuelSpill            Boolean? @map("oil_fuel_spill")
  fireExtinguisherPresent Boolean? @map("fire_extinguisher_present")
  updatedAt               DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("non_technical_observations")
}

model EarthingReading {
  visitId                String   @id @map("visit_id") @db.Char(36)
  siteId                 String   @map("site_id") @db.Char(36)
  recordedAt             DateTime @map("recorded_at")
  inspected              Boolean?
  earthCableConnected    Boolean? @map("earth_cable_connected")
  freeFromCorrosion      Boolean? @map("free_from_corrosion")
  pitConditionAcceptable Boolean? @map("pit_condition_acceptable")
  abnormalitiesFound     Boolean? @map("abnormalities_found")
  updatedAt              DateTime @updatedAt @map("updated_at")

  visit PmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  site  Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([siteId, recordedAt])
  @@map("earthing_readings")
}

/// Administrator-changeable settings (e.g. the PM start geofence), as JSON by key.
/// The API supplies defaults for keys never saved.
model SystemSetting {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by") @db.Char(36)

  @@map("system_settings")
}
