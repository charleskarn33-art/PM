{
  "name": "ipt-powertech-pm",
  "private": true,
  "version": "0.1.0",
  "description": "IPT PowerTech PM System \u2014 telecom site power preventive maintenance platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "test": "pnpm --filter \"!@ipt/db-tests\" -r run test",
    "test:db": "pnpm --filter @ipt/db-tests run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db",
    "dev:web": "pnpm --filter @ipt/web dev",
    "dev:mobile": "pnpm --filter @ipt/mobile start",
    "format": "prettier --write .",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:types:check": "node scripts/gen-db-types.mjs --check",
    "tools:postgrest": "./scripts/fetch-postgrest.sh",
    "test:e2e": "pnpm --filter @ipt/e2e run e2e",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "dev:api": "pnpm --filter @ipt/api dev",
    "test:api": "pnpm --filter @ipt/api test:integration",
    "db:seed": "tsx prisma/seed.mts",
    "db:seed:demo": "tsx prisma/seed-demo.mts",
    "db:create-admin": "tsx prisma/create-admin.mts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma"
    ]
  }
}
