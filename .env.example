# Local development. Copy to .env (never committed) and adjust.
# Production values live on the server (docker/.env) or the hosting provider.

# --- API -----------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
# Public URLs (used for CORS, links and signed file URLs)
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# MySQL 8 (Prisma). The API is the only client of the database.
# allowPublicKeyRetrieval=true: MySQL 8's default authentication without TLS; only for
# localhost or a private network. Across any other network use TLS: ?ssl=true&sslCa=/path/ca.pem
DATABASE_URL=mysql://ipt_pm:change-me@127.0.0.1:3306/ipt_pm?allowPublicKeyRetrieval=true
# Only for `prisma migrate dev` (a scratch database the user may drop and recreate)
SHADOW_DATABASE_URL=mysql://ipt_pm:change-me@127.0.0.1:3306/ipt_pm_shadow

# JWT signing secrets: long random strings (e.g. `openssl rand -base64 48`), different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes (seconds)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Sign-in protection: lock an account for AUTH_LOCKOUT_MINUTES after AUTH_MAX_FAILED_LOGINS
# consecutive failures; per-IP request limit for the sign-in and token endpoints
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_PER_MINUTE=10
# A just-used refresh token is accepted again for this many seconds (parallel requests from
# one browser); later reuse is treated as theft and ends the session. 0 = no grace period.
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
# Shared with the web app's server (same value in apps/web/.env.local) so the API sees each
# browser's IP for rate limits and session records. Random, at least 32 characters. Optional.
WEB_FORWARD_SECRET=

# File storage (photos, signatures, PDFs): local disk now, S3-compatible later
STORAGE_DRIVER=local
STORAGE_PATH=./storage
STORAGE_BASE_URL=http://localhost:3001/api/v1/files

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Integration tests: a separate, disposable database
TEST_DATABASE_URL=mysql://ipt_pm:change-me@127.0.0.1:3306/ipt_pm_test?allowPublicKeyRetrieval=true
