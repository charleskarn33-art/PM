# Supabase project (Project Settings -> API). Only the public URL and the
# publishable/anon key belong here. NEVER put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only (never NEXT_PUBLIC_): required for inviting users from Admin → Users.
# Set it only in the server environment (e.g. Vercel project env), never in the browser.
SUPABASE_SECRET_KEY=
# Public base URL used in invitation / password-reset links (optional; defaults to the request host).
SITE_URL=http://localhost:3000
