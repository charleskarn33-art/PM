# The IPT PM API (NestJS). The web server calls it; browsers never do, and never see tokens.
# Base URL without /api/v1. Use https:// in production unless the API is on the same host or
# private network (e.g. http://api:3001 inside Docker Compose).
API_URL=http://localhost:3001
# Same value as WEB_FORWARD_SECRET in the API's environment (optional, 32+ random characters).
# Lets the API rate-limit and record sessions per browser IP instead of per web server.
WEB_FORWARD_SECRET=
