# The IPT PM API (NestJS). The app talks only to the API — never to the database.
# https:// required, except a local development server (localhost, 10.0.2.2 for the
# Android emulator, or a private LAN address).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# --- Legacy (Supabase) ------------------------------------------------------------------------
# Only for the offline data sync until it moves to the API (Phase 7). Sign-in no longer uses it.
# Publishable/anon key ONLY — never a service-role key (it would be extractable from the app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
