# VPS deployment (docker/docker-compose.yml). Copy to docker/.env on the server
# (never committed; chmod 600). Use long random values: openssl rand -hex 32
# (hex keeps passwords safe inside the database URL).

API_DOMAIN=api.example.com
API_URL=https://api.example.com
WEB_URL=https://pm.example.com
CORS_ORIGIN=https://pm.example.com
STORAGE_BASE_URL=https://api.example.com/api/v1/files

MYSQL_DATABASE=ipt_pm
MYSQL_USER=ipt_pm
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

JWT_SECRET=
JWT_REFRESH_SECRET=

LOG_LEVEL=info
APP_VERSION=
